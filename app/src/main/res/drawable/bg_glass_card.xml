<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_glass_60" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Top-left highlight line -->
    <item android:left="1dp" android:top="1dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/electric_violet_light" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Subtle light leak -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/electric_violet_light"
                android:centerColor="@color/transparent"
                android:endColor="@color/transparent" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</layer-list>

