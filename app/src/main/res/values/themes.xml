<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PatikaGunlugu" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryVariant</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        
        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        
        <!-- Premium material dialog styling -->
        <item name="materialAlertDialogTheme">@style/Theme.App.AlertDialog</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/playfair_display_family</item>
        <item name="android:fontFamily">@font/playfair_display_family</item>
        <item name="android:textColor">@color/colorOnBackground</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/playfair_display_family</item>
        <item name="android:fontFamily">@font/playfair_display_family</item>
        <item name="android:textColor">@color/colorOnBackground</item>
    </style>

    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/playfair_display_family</item>
        <item name="android:fontFamily">@font/playfair_display_family</item>
        <item name="android:textColor">@color/colorOnBackground</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/dm_sans_family</item>
        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="android:textColor">@color/colorOnBackground</item>
    </style>

    <style name="TextAppearance.App.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/dm_sans_family</item>
        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>

    <style name="TextAppearance.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/dm_sans_family</item>
        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/dm_sans_family</item>
        <item name="android:fontFamily">@font/dm_sans_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/bottom_nav_indicator_color</item>
    </style>

    <!-- Component Styles -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Eski ekranlar için korunan temel buton stili -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Button</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.App.TextField" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Thumbnail" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize16dp" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize24dp" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Circle crop for ShapeableImageView -->
    <style name="CircleImageStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <!-- Dedicated splash theme: always light, lavender window background -->
    <style name="Theme.PatikaGunlugu.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/backgroundStart</item>
        <item name="android:statusBarColor">@color/backgroundStart</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/backgroundEnd</item>
        
        <!-- Android 12+ System Splash Screen Customization: removes the default book icon page -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/backgroundStart</item>
    </style>

    <!-- Premium themed MaterialAlertDialog styles -->
    <style name="Theme.App.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundTint">@color/colorSurfaceVariant</item> <!-- Premium lavender-tint surface background -->
        <item name="shapeAppearance">@style/ShapeAppearance.App.Dialog</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>

</resources>